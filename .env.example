# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (required) ---
# Postgres connection string, e.g. postgresql://user:pass@host:5432/menta
# Every environment (local/staging/production) needs its own database — never
# point more than one environment at the same DATABASE_URL.
DATABASE_URL="postgresql://menta:menta@localhost:5432/menta"

# --- Sessions (required) ---
# Random 32+ byte secret used to sign session + password-reset tokens.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-value"

# Base URL of this deployment, used to build links in emails.
APP_URL="http://localhost:3000"

# --- MENTA AI (optional — AI chat shows "not connected" until set) ---
# Server-side only. Never expose these to the browser.
# AI_PROVIDER selects which provider buildAthleteContext()/askMentaAi() call
# out to: "gemini" (default) or "anthropic". Only the selected provider's key
# needs to be set.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# --- Transactional email (optional — password-reset links log to the server
# console in dev when unset, instead of actually sending) ---
RESEND_API_KEY=""
EMAIL_FROM="MENTA <no-reply@example.com>"

# --- Google/Facebook sign-in (optional — the buttons on login/signup show
# an honest "not configured" error until both id+secret are set for a
# given provider). Redirect URI to register with each provider:
#   {APP_URL}/api/auth/oauth/google/callback
#   {APP_URL}/api/auth/oauth/facebook/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Google Classroom integration (optional — Academics shows an honest
# "not configured" state until this is set; reuses GOOGLE_CLIENT_ID/SECRET
# above, same Google Cloud OAuth client, different scopes/consent than
# Google sign-in). Additional redirect URI to register on that OAuth
# client (Google sign-in's own callback above is untouched):
#   {APP_URL}/api/integrations/google/classroom/callback
# TOKEN_ENCRYPTION_KEY encrypts the stored refresh/access tokens at rest —
# required once a user actually connects (not needed just to show the
# "not connected" card). Generate one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# --- Stripe billing (optional — the pricing page and Plan/entitlement
# data work with this unset; checkout/portal buttons show an honest
# "billing not configured" state until it's set, same pattern as the AI
# provider keys above). STRIPE_WEBHOOK_SECRET verifies webhook signatures —
# required once you're actually receiving events, not needed to see the
# "not connected" state.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Where Team/Organization "Contact us" inquiries are emailed. Falls back to
# console logging (via sendEmail's existing RESEND_API_KEY-unset behavior)
# until both this and RESEND_API_KEY are set.
PARTNERSHIPS_EMAIL="partnerships@menta.app"

# --- File storage (avatars, documents, film) ---
# Max upload sizes in MB. Each defaults sensibly if unset (see src/lib/storage.ts).
MAX_UPLOAD_MB="300"
MAX_DOCUMENT_UPLOAD_MB="20"
MAX_AVATAR_UPLOAD_MB="8"

# Cloudflare R2 (S3-compatible object storage) — required in any deployed
# environment (staging/production). All four must be set together; if any
# is missing, src/lib/storage.ts falls back to local disk, which
# isUploadStorageConfigured() then refuses to use outside NODE_ENV=development
# (uploads return an honest 503 instead of silently writing to a serverless
# filesystem that won't still have the file on the next request). Create a
# bucket + an API token scoped to it (Object Read & Write) per environment —
# never share one bucket/token between staging and production.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
