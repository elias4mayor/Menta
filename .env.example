# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (required) ---
# Dev default: local SQLite file, zero setup.
# Production: point at Postgres, e.g. postgresql://user:pass@host:5432/menta
DATABASE_URL="file:./dev.db"

# --- Sessions (required) ---
# Random 32+ byte secret used to sign session + password-reset tokens.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-value"

# Base URL of this deployment, used to build links in emails.
APP_URL="http://localhost:3000"

# --- MENTA AI (optional — AI chat shows "not connected" until set) ---
# Server-side only. Never expose this to the browser.
ANTHROPIC_API_KEY=""

# --- Transactional email (optional — password-reset links log to the server
# console in dev when unset, instead of actually sending) ---
RESEND_API_KEY=""
EMAIL_FROM="MENTA <no-reply@example.com>"
