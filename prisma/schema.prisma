// MENTA — Phase 1 data model.
// Dev uses SQLite (zero-config). Swap `provider`/`url` to Postgres for production —
// see .env.example. Role/status fields are plain strings (not native enums) so the
// schema works unmodified against either connector; allowed values are enforced in
// src/lib/permissions.ts and src/lib/validation.ts, not by the database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Roles: SUPER_ADMIN, DEVELOPER, MENTA_STAFF, ORG_ADMIN, SCHOOL_ADMIN,
/// ATHLETIC_DIRECTOR, COACH, TRAINER, ATHLETE, PARENT
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          String    @default("ATHLETE")
  dateOfBirth   DateTime?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  athleteProfile   AthleteProfile?
  sessions         Session[]
  resetTokens      PasswordResetToken[]
  memberships      TeamMembership[]
  messages         Message[]
  conversations    ConversationParticipant[]
  notifications    Notification[]
  auditLogs        AuditLog[]            @relation("AuditActor")
  aiConversations  AIConversation[]
  createdEvents    CalendarEvent[]       @relation("EventCreator")
  goals            Goal[]
  createdTeams     Team[]                @relation("TeamCreator")
  guardianOf       GuardianLink[]        @relation("Guardian")
  athleteGuardians GuardianLink[]        @relation("AthleteOfGuardian")
  reportsFiled     Report[]              @relation("Reporter")
  blocksMade       Block[]               @relation("Blocker")
  blocksReceived   Block[]               @relation("Blocked")

  @@index([role])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Visibility: PRIVATE, TEAM, ORGANIZATION, RECRUITING, PUBLIC
model AthleteProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  sport                 String?
  position              String?
  graduationYear        Int?
  heightCm              Int?
  weightKg              Int?
  schoolName            String?
  city                  String?
  state                 String?
  bio                   String?
  gpa                   Float?
  visibility            String    @default("PRIVATE")
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  teams Team[]
}

model Team {
  id             String   @id @default(cuid())
  name           String
  sport          String?
  organizationId String?
  inviteCode     String   @unique
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization?    @relation(fields: [organizationId], references: [id])
  createdBy    User             @relation("TeamCreator", fields: [createdById], references: [id])
  memberships  TeamMembership[]
  events       CalendarEvent[]
  conversation Conversation?

  @@index([organizationId])
}

/// TeamRole: COACH, ATHLETE, TRAINER, PARENT, ADMIN
model TeamMembership {
  id       String   @id @default(cuid())
  userId   String
  teamId   String
  teamRole String   @default("ATHLETE")
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

/// Status: ACTIVE, ACHIEVED, ABANDONED
model Goal {
  id         String    @id @default(cuid())
  userId     String
  title      String
  category   String?
  targetDate DateTime?
  status     String    @default("ACTIVE")
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id        String   @id @default(cuid())
  isGroup   Boolean  @default(false)
  teamId    String?  @unique
  title     String?
  createdAt DateTime @default(now())

  team         Team?                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User          @relation(fields: [senderId], references: [id])

  @@index([conversationId])
}

/// Visibility: PRIVATE (creator only), TEAM, PUBLIC
model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  teamId      String?
  createdById String
  visibility  String    @default("PRIVATE")
  createdAt   DateTime  @default(now())

  team      Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User  @relation("EventCreator", fields: [createdById], references: [id])

  @@index([teamId])
  @@index([createdById])
}

/// Type: INFO, TRAINING, RECOVERY, RECRUITING, ACADEMICS, SAFETY, MESSAGE, AI, SYSTEM
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @default("INFO")
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
}

/// Role: user, assistant
model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
}

/// Category: SPAM, HARASSMENT, SAFETY_CONCERN, IMPERSONATION, OTHER
/// Status: OPEN, REVIEWED, DISMISSED, ACTIONED
model Report {
  id             String   @id @default(cuid())
  reporterId     String
  targetUserId   String?
  targetMessageId String?
  category       String
  details        String?
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id])

  @@index([status])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

/// Status: PENDING, APPROVED, REVOKED — a parent/guardian requesting linked visibility into a minor athlete's account
model GuardianLink {
  id         String   @id @default(cuid())
  guardianId String
  athleteId  String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  guardian User @relation("Guardian", fields: [guardianId], references: [id])
  athlete  User @relation("AthleteOfGuardian", fields: [athleteId], references: [id])

  @@unique([guardianId, athleteId])
}
